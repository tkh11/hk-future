# Local development only. Run npm run cms:local:init for generated secrets.
CMS_ENABLED=true
CMS_SERVER_URL=http://localhost:3000
DATABASE_URL=postgresql://heisskraft:REPLACE_ME@127.0.0.1:5433/heisskraft
PAYLOAD_SECRET=REPLACE_WITH_RANDOM_32_OR_MORE_CHARACTERS
# Required on an external host: an MFA/VPN gateway injects this secret header.
CMS_GATEWAY_SECRET=
# Keep the bucket private. Do not expose confidential corporate documents here.
S3_ENDPOINT=
S3_REGION=ru-1
S3_BUCKET=
S3_PREFIX=heisskraft-development
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
METRIKA_ENABLED=false
NEXT_PUBLIC_SITE_URL=
METRIKA_COUNTER_ID=
METRIKA_READ_TOKEN=
