{
  "name": "hk-future",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:production": "NEXT_BUILD_DIR=.next-production next build",
    "start:production": "NEXT_BUILD_DIR=.next-production next start --port 3100",
    "build:export": "node scripts/build-export.mjs",
    "test:assets": "node scripts/check-export.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "cms:local:init": "node scripts/cms/local-init.mjs",
    "cms:types": "payload generate:types",
    "cms:importmap": "payload generate:importmap",
    "cms:migrate": "payload migrate",
    "cms:migration:create": "payload migrate:create",
    "cms:bootstrap": "node --env-file=.env.local --import tsx scripts/cms/bootstrap.ts",
    "cms:seed": "node --env-file=.env.local --import tsx scripts/cms/seed.ts",
    "cms:test": "node scripts/cms/test-access.mjs && node scripts/cms/test-import.mjs && node scripts/cms/test-paths.mjs",
    "cms:backup": "node scripts/cms/backup.mjs",
    "cms:restore-check": "node scripts/cms/restore-check.mjs",
    "test:cms:e2e": "playwright test --config playwright.cms.config.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.0",
    "@payloadcms/next": "3.92.0",
    "@payloadcms/storage-s3": "3.92.0",
    "@payloadcms/translations": "3.92.0",
    "@payloadcms/ui": "3.92.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@rive-app/canvas": "^2.43.1",
    "drizzle-orm": "0.45.2",
    "exceljs": "4.4.0",
    "graphql": "16.11.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "libphonenumber-js": "^1.13.15",
    "next": "16.4.2",
    "payload": "3.92.0",
    "pg": "8.20.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "three": "^0.186.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/pg": "8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.3",
    "meshoptimizer": "1.1.1",
    "node": "24.22.1",
    "tailwindcss": "^4",
    "tsx": "4.20.6",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11.19.0 <12"
  },
  "packageManager": "npm@11.19.0",
  "overrides": {
    "dompurify": "3.4.17",
    "esbuild": "0.25.12",
    "uuid": "11.1.1"
  },
  "type": "module"
}
