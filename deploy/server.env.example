# Copy into .local/server.env (mode 0600) on the prepared server.
# Use a different file and different secrets for staging and production.
CMS_SERVER_URL=https://REPLACE_WITH_THIS_ENVIRONMENT_HOST
# Pass this SAME nonsecret origin as Docker --build-arg NEXT_PUBLIC_SITE_URL.
# Setting it only at runtime cannot change the origin embedded in a built image.
NEXT_PUBLIC_SITE_URL=https://REPLACE_WITH_THIS_ENVIRONMENT_HOST
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_URL_ENCODED_PASSWORD@REPLACE_PRIVATE_DB_HOST:5432/REPLACE_DB_NAME?sslmode=verify-full
PAYLOAD_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CMS_GATEWAY_SECRET=REPLACE_WITH_RANDOM_SECRET_SHARED_ONLY_WITH_GATEWAY
S3_ENDPOINT=https://REPLACE_WITH_PRIVATE_S3_ENDPOINT
S3_REGION=REPLACE_WITH_PROVIDER_REGION
S3_BUCKET=REPLACE_WITH_PRIVATE_ENVIRONMENT_BUCKET
S3_PREFIX=heisskraft-production
S3_ACCESS_KEY_ID=REPLACE_WITH_BUCKET_SCOPED_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_BUCKET_SCOPED_SECRET
METRIKA_ENABLED=false
METRIKA_COUNTER_ID=
METRIKA_READ_TOKEN=
# Bootstrap values are passed to the one-shot operations command separately.
