{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@payload-config": [
        "./payload.config.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-production/types/**/*.ts",
    ".next-production/dev/types/**/*.ts",
    ".next-critical-ch/types/**/*.ts",
    ".next-critical-ch/dev/types/**/*.ts",
    ".next-critical-dev/types/**/*.ts",
    ".next-critical-dev/dev/types/**/*.ts",
    ".next-critical-baseline/types/**/*.ts",
    ".next-critical-baseline/dev/types/**/*.ts",
    ".next-admin-redesign/types/**/*.ts",
    ".next-admin-redesign/dev/types/**/*.ts",
    ".next-hk_test_admin_df0eeb05f8926745/types/**/*.ts",
    ".next-hk_test_admin_df0eeb05f8926745/dev/types/**/*.ts",
    ".next-hk_test_admin_948c9ef1223b1e5a/types/**/*.ts",
    ".next-hk_test_admin_948c9ef1223b1e5a/dev/types/**/*.ts",
    ".next-hk_test_admin_aca542d1f3ec8c49/types/**/*.ts",
    ".next-hk_test_admin_aca542d1f3ec8c49/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next-production",
    ".next-export",
    ".local"
  ]
}
